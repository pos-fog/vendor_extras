android_app_import {
    name: "Accord",
    apk: "accord/accord.apk",
    certificate: "platform",
    product_specific: true,
    overrides: ["Twelve"],
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

android_app_import {
    name: "GrapheneCamera",
    apk: "graphenecamera/GrapheneCamera.apk",
    preprocessed: true,
    presigned: true,
    product_specific: true,
    overrides: ["Snap", "Camera", "Camera2", "Aperture", "Flash", "GoogleCameraGo"],
}
